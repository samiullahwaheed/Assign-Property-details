{
    "functions": {
        "*.php": {
            "runtime": "vercel-php@0.7.4"
        },
        "admin/*.php": {
            "runtime": "vercel-php@0.7.4"
        }
    },
    "routes": [
        { "src": "/assets/(.*)", "dest": "/assets/$1" },
        { "src": "/uploads/(.*)", "dest": "/uploads/$1" },
        { "src": "/admin/(.*)", "dest": "/admin/$1" },
        { "src": "/(.*)", "dest": "/$1" }
    ]
}

